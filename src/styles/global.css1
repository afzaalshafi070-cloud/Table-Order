/* Animated Live Background & Strict Readability Dark/Light Rules */

:root {
  --brand-primary: #e11d48;
  --brand-secondary: #f97316;
  --brand-accent: #fbbf24;
  --brand-dark: #9f1239;
  --brand-light: #ffe4e6;
  --brand-bg-layer1: #fff1f2;
  --brand-bg-layer2: #fff7ed;
  
  --bg-main: #f8fafc;
  --card-bg: rgba(255, 255, 255, 0.90);
  --card-border: rgba(226, 232, 240, 0.8);
  --text-main: #0f172a;
  --text-muted: #64748b;
  --input-bg: #ffffff;
}

body {
  margin: 0;
  padding: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  background-color: var(--bg-main);
  color: var(--text-main);
  transition: background-color 0.3s ease, color 0.3s ease;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

/* LIVE ANIMATED BACKGROUND LAYER */
.animated-bg-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.28;
  animation: floatingGlow 18s infinite alternate ease-in-out;
}

.dark .bg-blob {
  opacity: 0.18;
}

.bg-blob-1 {
  top: -10%;
  left: -10%;
  width: 50vw;
  height: 50vw;
  background: var(--brand-primary);
  animation-duration: 22s;
}

.bg-blob-2 {
  bottom: -15%;
  right: -10%;
  width: 55vw;
  height: 55vw;
  background: var(--brand-secondary);
  animation-duration: 26s;
  animation-delay: -5s;
}

.bg-blob-3 {
  top: 40%;
  left: 30%;
  width: 35vw;
  height: 35vw;
  background: var(--brand-accent);
  animation-duration: 20s;
  animation-delay: -10s;
}

@keyframes floatingGlow {
  0% {
    transform: translate(0, 0) scale(1) rotate(0deg);
  }
  50% {
    transform: translate(8%, 10%) scale(1.1) rotate(45deg);
  }
  100% {
    transform: translate(-5%, 5%) scale(0.95) rotate(90deg);
  }
}

/* STRICT DARK MODE READABILITY OVERRIDES */
.dark {
  color-scheme: dark;
}

.dark body {
  background-color: #0f172a;
  color: #f8fafc;
}

.dark h1, .dark h2, .dark h3, .dark h4, .dark h5, .dark h6,
.dark .menu-item-title, .dark .restaurant-name, .dark .price-tag,
.dark .cart-item-name, .dark .category-tab-active {
  color: #f8fafc !important;
}

.dark p, .dark .text-muted, .dark .description {
  color: #cbd5e1 !important;
}

.dark .card, .dark .bg-white {
  background-color: var(--card-bg) !important;
  border-color: var(--card-border) !important;
  color: #f8fafc !important;
}

.dark input, .dark select, .dark textarea {
  background-color: var(--input-bg) !important;
  color: #f8fafc !important;
  border-color: rgba(255, 255, 255, 0.2) !important;
}

.dark button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* NEW ORDER FLASH HIGHLIGHT IN COUNTER */
@keyframes newOrderPulse {
  0% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.6); }
  70% { box-shadow: 0 0 0 15px rgba(225, 29, 72, 0); }
  100% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0); }
}

.new-order-highlight {
  animation: newOrderPulse 2s ease-out 3;
  border: 2px solid var(--brand-primary) !important;
}
